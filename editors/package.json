{
  "name": "fdf",
  "displayName": "fdf",
  "publisher": "SideQuestLabs",
  "version": "0.2.0",
  "description": "Syntax highlighting for fdf files",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/SideQuestLabsX/fdf.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fdf",
